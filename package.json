{
  "name": "mdxpad",
  "version": "0.1.0",
  "description": "A macOS-first MDX editor",
  "type": "module",
  "main": "dist/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "overrides": {
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "rollup@<4.59.0": "4.59.0"
    }
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bench": "tsx scripts/bench.ts",
    "verify-security": "tsx scripts/verify-security.ts",
    "rehearse:hardening": "tsx scripts/rehearse-hardening.ts",
    "rehearse:release": "tsx scripts/rehearse-release.ts",
    "verify-lockfiles": "node scripts/verify-lockfiles.mjs",
    "verify-actions-pinning": "tsx scripts/verify-actions-pinning.ts",
    "verify-audit-baseline": "tsx scripts/verify-audit-baseline.ts",
    "check:quality-gates": "pnpm verify-lockfiles && pnpm verify-actions-pinning && pnpm verify-audit-baseline && pnpm typecheck && pnpm lint && pnpm test",
    "generate-supplychain-scaffold": "tsx scripts/generate-supplychain-scaffold.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "clean": "rm -rf dist out .vite coverage",
    "coverage": "vitest run --coverage",
    "coverage:critical": "tsx scripts/check-critical-coverage.ts",
    "audit:types": "echo '=== Type Safety Audit ===' && echo 'as unknown as:' && grep -r 'as unknown as' src/ --include='*.ts' --include='*.tsx' -c 2>/dev/null | tail -1 && echo 'as any:' && grep -r 'as any' src/ --include='*.ts' --include='*.tsx' -c 2>/dev/null | tail -1 && echo 'eslint-disable:' && grep -r 'eslint-disable' src/ --include='*.ts' --include='*.tsx' -c 2>/dev/null | tail -1",
    "lint:report": "eslint . --format json 2>/dev/null | node -e \"const d=JSON.parse(require('fs').readFileSync('/dev/stdin','utf8'));const r={};d.forEach(f=>f.messages.forEach(m=>{r[m.ruleId]=(r[m.ruleId]||0)+1}));Object.entries(r).sort((a,b)=>b[1]-a[1]).forEach(([k,v])=>console.log(v+'\\t'+k))\"",
    "prepare": "husky",
    "docs:dev": "cd docs-site && pnpm dev",
    "docs:build": "cd docs-site && pnpm build",
    "docs:start": "cd docs-site && pnpm start"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/openai": "^3.0.12",
    "@ai-sdk/openai-compatible": "^2.0.13",
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.10.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.2",
    "@codemirror/language": "^6.12.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.39.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lezer/highlight": "^1.2.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@replit/codemirror-indentation-markers": "^6.5.3",
    "ai": "^6.0.39",
    "chokidar": "5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.3",
    "docx": "^9.6.0",
    "electron-store": "11.0.2",
    "epub-gen-memory": "^1.1.2",
    "fzf": "^0.5.2",
    "glob": "13.0.6",
    "gray-matter": "^4.0.3",
    "immer": "^10.0.0",
    "katex": "^0.16.33",
    "lib0": "^0.2.117",
    "lucide-react": "^0.514.0",
    "mermaid": "^11.12.3",
    "minisearch": "^7.2.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.4",
    "prosemirror-model": "^1.25.4",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.41.6",
    "react-resizable-panels": "^4.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-stringify": "^11.0.0",
    "simple-git": "^3.32.3",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yaml": "^2.8.2",
    "yjs": "^13.6.29",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "happy-dom": "^20.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mdast-util-mdx-jsx": "^3.2.0",
    "ollama-ai-provider": "^1.2.0",
    "playwright": "^1.49.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "unist-util-visit": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
